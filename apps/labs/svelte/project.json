{
  "name": "labs-svelte",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/labs/svelte/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev --port 4200",
        "cwd": "apps/labs/svelte"
      }
    },
    "build": {
      "executor": "@nxext/sveltekit:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/labs/svelte"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --port 4300",
        "cwd": "apps/labs/svelte"
      }
    },
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "svelte-kit sync",
        "cwd": "apps/labs/svelte"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "svelte-check --tsconfig ./tsconfig.json",
        "cwd": "apps/labs/svelte"
      }
    },
    "add": {
      "executor": "@nxext/sveltekit:add"
    },
    "lint": {
      "command": "eslint apps/labs/svelte/**/*.{ts,svelte,spec.ts}"
    }
  }
}