{
  "compilerOptions": {
    "composite": true,
    "declaration": false,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@sx-bluecrow-ui/source"],
    "paths": {
      "@sx-bluecrow-ui/core-cache": ["./libs/core/cache/src/index.ts"],
      "@sx-bluecrow-ui/core-network": ["./libs/core/network/src/index.ts"],
      "@sx-bluecrow-ui/core-storage": ["./libs/core/storage/src/index.ts"],
      "@sx-bluecrow-ui/core-validation": ["./libs/core/validation/src/index.ts"]
    }
  }
}